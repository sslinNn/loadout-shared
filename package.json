{
  "name": "@loadout/shared",
  "version": "0.0.1",
  "description": "Shared zod schemas for the Loadout agent and dashboard.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sslinNn/loadout-shared.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "private": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
